LLM_MODEL=deepseek/deepseek-v4-flash
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=20
APP_ENV=development
AUTO_SEED_DEMO=false
DATABASE_URL=sqlite:///./data/devicepilot.db
CORS_ORIGINS=
DIAGNOSIS_RATE_LIMIT_PER_MINUTE=5
TRUST_PROXY_HEADERS=false
RAG_ENABLED=false
RAG_KNOWLEDGE_PATH=./knowledge
# RAG_VECTOR_STORE_PATH is canonical; RAG_CHROMA_PATH remains a legacy fallback.
RAG_VECTOR_STORE_PATH=./data/chroma
RAG_COLLECTION_NAME=devicepilot_knowledge
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_TOP_K=3
RAG_MAX_DISTANCE=0.143
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80
RAG_MAX_FILE_BYTES=1000000

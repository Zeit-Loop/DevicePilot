# Compose version/tag and local validation overrides. Replace APP_VERSION for each release.
APP_VERSION=replace-with-git-sha-or-release-tag
BACKEND_ENV_FILE=./deploy/.env.production.example
CADDY_ENV_FILE=./deploy/.env.production.example
BACKUP_DIR=/var/backups/devicepilot

# Placeholder values only. Production values belong in root-owned /etc/devicepilot/*.env.
DEVICEPILOT_DOMAIN=devicepilot.example.test
ACME_EMAIL=ops@example.test
BASIC_AUTH_USERNAME=operator
BASIC_AUTH_PASSWORD_HASH='$2a$14$TLALtLC3Ieh7Ym95.PZRe.jFsl2KJy3kf2mpgl9rnveKtSoTbpreq'
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=20
DIAGNOSIS_RATE_LIMIT_PER_MINUTE=5
RAG_ENABLED=false
RAG_COLLECTION_NAME=devicepilot_knowledge
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_TOP_K=3
RAG_MAX_DISTANCE=0.143
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80
RAG_MAX_FILE_BYTES=1000000
